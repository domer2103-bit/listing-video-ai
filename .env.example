# Claude — scene plan / narration script generation
ANTHROPIC_API_KEY=

# kie.ai — Kling image-to-video scene animation
KIE_API_KEY=
# KIE_API_BASE=https://api.kie.ai/api/v1
# KIE_MODEL=kling-2.6/image-to-video

# Inworld AI — narration text-to-speech
# The key IS the Basic-auth credential — paste it as-is after "Basic ".
INWORLD_API_KEY=
# INWORLD_API_BASE=https://api.inworld.ai/tts/v1
# INWORLD_VOICE_ID=Dennis
# INWORLD_MODEL_ID=inworld-tts-1.5-max

# Google Maps Platform — satellite + Street View establishing-shot intro.
# Optional: without this, the pipeline just skips the establishing shots
# and starts on the first interior/exterior scene. Needs "Maps Static API"
# and "Street View Static API" enabled + billing on the Google Cloud project.
GOOGLE_MAPS_API_KEY=
